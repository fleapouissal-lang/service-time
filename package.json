{
  "name": "service-time",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/types"
  ],
  "scripts": {
    "dev": "node scripts/sync-env.mjs && node scripts/clean-dev-lock.mjs && npm run dev -w web",
    "sync-env": "node scripts/sync-env.mjs",
    "check:email": "node scripts/check-email-env.mjs",
    "test:smtp": "node scripts/test-smtp.mjs",
    "build": "npm run build -w web",
    "build:web": "node scripts/sync-env.mjs && npm run bundle:imgly-bg -w web && npm run build -w web",
    "setup:imgly-assets": "npm run setup:imgly-assets -w web",
    "setup:imgly-assets:force": "npm run setup:imgly-assets:force -w web",
    "bundle:imgly-bg": "npm run bundle:imgly-bg -w web",
    "postinstall": "npm run postinstall -w web --if-present",
    "start:web": "node scripts/sync-env.mjs && node scripts/ensure-web-build.mjs && npm run start -w web -- --port 3000",
    "pm2:prod": "pm2 start ecosystem.config.cjs",
    "lint": "npm run lint -w web",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:seed": "node scripts/seed-database.mjs",
    "db:seed-profiles": "node scripts/seed-profiles.mjs",
    "db:create-admin": "node scripts/create-admin.mjs",
    "db:password-reset-table": "node scripts/apply-password-reset-table.mjs",
    "db:contact-table": "node scripts/apply-contact-table.mjs",
    "db:client-registration": "node scripts/apply-client-registration.mjs",
    "db:profile-avatars": "node scripts/apply-profile-avatars.mjs",
    "db:delete-clients": "node scripts/delete-client-users.mjs --confirm",
    "db:client-dashboard-rls": "node scripts/apply-client-dashboard-rls.mjs",
    "db:create-service-request-rpc": "node scripts/apply-create-service-request-rpc.mjs",
    "db:technician-location": "node scripts/apply-technician-location-tracking.mjs",
    "db:client-vehicles": "node scripts/apply-client-vehicles.mjs",
    "db:profile-names": "node scripts/apply-profile-localized-names.mjs",
    "db:request-status-assigned": "node scripts/apply-request-status-assigned.mjs",
    "db:push": "npx supabase db push"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "pg": "^8.16.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2"
}
