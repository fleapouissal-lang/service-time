# =============================================================================
# Copier vers .env à la racine — npm run sync-env → apps/web/.env.local
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HTTP (VPS IP sans SSL) : false — HTTPS : true ou laisser vide (auto depuis APP_URL)
# AUTH_COOKIE_SECURE=false

# --- Supabase (web / Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (serveur + migrations) ---
SUPABASE_SERVICE_ROLE_KEY=
# Migrations (npm run db:migrate) — copier depuis Supabase → Connect → Session pooler → URI
# Windows : préférer le pooler Session (IPv4) ; user = postgres.VOTRE_REF (pas seulement postgres)
# Copier le host EXACT depuis le dashboard (souvent aws-1-REGION, pas aws-0)
# Exemple : postgresql://postgres.abcdefgh:MotDePasse@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Direct (VPS Linux souvent OK) : postgresql://postgres:MotDePasse@db.abcdefgh.supabase.co:5432/postgres
# Ne pas laisser de placeholder du type aws-0-XX-XX ou [PASSWORD]
DATABASE_URL=

# --- Email (Gmail SMTP ou laisser vide + RESEND_API_KEY) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Service Time <noreply@example.com>
CONTACT_NOTIFY_EMAIL=
# RESEND_API_KEY=

# --- Sécurité ---
PASSWORD_RESET_SECRET=

# --- WhatsApp ---
WHATSAPP_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Paymob / Accept ---
PAYMOB_BASE_URL=https://ksa.paymob.com
PAYMOB_SECRET_KEY=
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=

# --- Optionnel ---
# OPENAI_API_KEY=
