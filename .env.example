# Supabase service role — SERVEUR UNIQUEMENT (upload photos Storage)
# Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Email OTP — mot de passe oublié
# Option A (recommandé avec Gmail perso) : SMTP + mot de passe d'application Google
#   1. https://myaccount.google.com/security → Validation en 2 étapes (activée)
#   2. https://myaccount.google.com/apppasswords → créer "Service Time"
#   3. Copier le mot de passe 16 caractères dans SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fleapouissal@gmail.com
SMTP_PASS=
EMAIL_FROM=Service Time <fleapouissal@gmail.com>
CONTACT_NOTIFY_EMAIL=fleapouissal@gmail.com

# Option B : Resend (https://resend.com) — laisser SMTP vide
# RESEND_API_KEY=
# EMAIL_FROM=Service Time <noreply@servicetime.sa>

PASSWORD_RESET_SECRET=

# URL publique de l'app (callbacks Accept / Paymob)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Traduction automatique des noms (profil) — optionnel, sinon API MyMemory
# OPENAI_API_KEY=

# Paiement en ligne — Accept (Paymob KSA) https://paymob.sa
PAYMOB_BASE_URL=https://ksa.paymob.com
PAYMOB_SECRET_KEY=
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=

# WhatsApp admin / entreprise — contact client, liens wa.me (un seul numéro)
# Maroc: 212680961521 ou 0680961521 | KSA: 9665XXXXXXXX
WHATSAPP_NUMBER=212680961521
NEXT_PUBLIC_WHATSAPP_NUMBER=212680961521

# WhatsApp Cloud API (optionnel — envoi automatique au client)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
